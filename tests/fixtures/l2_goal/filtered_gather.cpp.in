template<int BlockThreads>
{{gatherCsrSegmentedParticlesKernel}}int main(){
for(int path=0;path<2;++path){DeviceState s;scans=0;
 for(int block=0;block<(path?8:4);++block){blockIdx.x=block;if(path)gatherCsrSegmentedParticlesKernel<1>(&s);else gatherCellLocalParticlesKernel<1>(&s);}
 int expected[7]={3,1,2,0,6,4,7};
 for(int i=0;i<7;++i){assert(s.compactPOrigId[i]==expected[i]);assert(s.compactPStatus[i]==1);}
 assert(s.compactPOrigId[7]==-1);
 assert(scans==3);
 std::cout<<"path="<<path<<" ordered filtering and heavy coverage PASS scans="<<scans<<"\n";
}}
