for(int i=0;i<32;++i)assert(oldState.solidPressurePhiMomY[i]==newState.solidPressurePhiMomY[i]);
for(int i=0;i<32;++i)assert(oldState.solidPressurePhiMomZ[i]==newState.solidPressurePhiMomZ[i]);
