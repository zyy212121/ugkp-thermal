int main(){for(int split=0;split<2;++split){DeviceState oldState;int count=9;oldState.particleCountDevice=&count;
 for(int i=0;i<9;++i){oldState.pStatus[i]=i==5?0:1;oldState.pux[i]=i*0.2;oldState.puy[i]=i*0.3;oldState.puz[i]=i*0.1;oldState.pTheta[i]=0.04;}
 int cells[9]={0,0,1,2,0,0,1,2,2};for(int i=0;i<9;++i)oldState.pCellId[i]=cells[i];
 int fullOff[4]={0,4,6,9},fullIdx[9]={0,1,4,5,2,6,3,7,8};
 int splitOff[4]={0,2,3,5},splitIdx[5]={4,5,6,7,8},baseOff[4]={0,2,3,4};
 for(int c=0;c<4;++c){oldState.cellParticleOffset[c]=split?splitOff[c]:fullOff[c];oldState.preBaseCellOffset[c]=baseOff[c];}
 for(int i=0;i<(split?5:9);++i)oldState.sortedParticleIndex[i]=split?splitIdx[i]:fullIdx[i];
 for(int c=0;c<3;++c){oldState.V[c]=1;oldState.cellPlaneStart[c]=2*c;oldState.cellPlaneCount[c]=2;
  oldState.momRhoP[c]=c==1?0:2;oldState.momRhoUPx[c]=2;oldState.momRhoUPy[c]=0;oldState.momRhoUPz[c]=0;oldState.momRhoEP[c]=c==2?1:10;
  for(int j=0;j<2;++j){int face=2*c+j;oldState.cellFaceId[face]=face;oldState.faceOwner[face]=c;oldState.solidPressurePhiMomX[face]=0.1;oldState.solidPressurePhiMomY[face]=0.02;oldState.solidPressurePhiMomZ[face]=-0.03;oldState.solidPressurePhiEnergy[face]=0.04;}}
 DeviceState newState=oldState;
 for(int c=0;c<3;++c){blockIdx.x=c;if(split)applyCollisionalPressureProjectionKernel<true>(&oldState,0.01);else applyCollisionalPressureProjectionKernel<false>(&oldState,0.01);}
 for(int c=0;c<3;++c){blockIdx.x=c;preparePressureProjectionCacheKernel(&newState,0.01);}
 blockIdx.x=0;applyCachedPressureProjectionParticlesKernel(&newState);
for(int i=0;i<32;++i)assert(oldState.Usx[i]==newState.Usx[i]);
for(int i=0;i<32;++i)assert(oldState.Usy[i]==newState.Usy[i]);
for(int i=0;i<32;++i)assert(oldState.Usz[i]==newState.Usz[i]);
for(int i=0;i<32;++i)assert(oldState.V[i]==newState.V[i]);
for(int i=0;i<32;++i)assert(oldState.momRhoEP[i]==newState.momRhoEP[i]);
for(int i=0;i<32;++i)assert(oldState.momRhoP[i]==newState.momRhoP[i]);
for(int i=0;i<32;++i)assert(oldState.momRhoUPx[i]==newState.momRhoUPx[i]);
for(int i=0;i<32;++i)assert(oldState.momRhoUPy[i]==newState.momRhoUPy[i]);
for(int i=0;i<32;++i)assert(oldState.momRhoUPz[i]==newState.momRhoUPz[i]);
for(int i=0;i<32;++i)assert(oldState.pTheta[i]==newState.pTheta[i]);
for(int i=0;i<32;++i)assert(oldState.pressureDeltaEnergy[i]==newState.pressureDeltaEnergy[i]);
for(int i=0;i<32;++i)assert(oldState.pressureDeltaMomX[i]==newState.pressureDeltaMomX[i]);
for(int i=0;i<32;++i)assert(oldState.pressureDeltaMomY[i]==newState.pressureDeltaMomY[i]);
for(int i=0;i<32;++i)assert(oldState.pressureDeltaMomZ[i]==newState.pressureDeltaMomZ[i]);
for(int i=0;i<32;++i)assert(oldState.pux[i]==newState.pux[i]);
for(int i=0;i<32;++i)assert(oldState.puy[i]==newState.puy[i]);
for(int i=0;i<32;++i)assert(oldState.puz[i]==newState.puz[i]);
for(int i=0;i<32;++i)assert(oldState.rhoEs[i]==newState.rhoEs[i]);
for(int i=0;i<32;++i)assert(oldState.rhoUsx[i]==newState.rhoUsx[i]);
for(int i=0;i<32;++i)assert(oldState.rhoUsy[i]==newState.rhoUsy[i]);
for(int i=0;i<32;++i)assert(oldState.rhoUsz[i]==newState.rhoUsz[i]);
