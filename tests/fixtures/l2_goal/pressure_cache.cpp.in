};
__device__ double pressureKickInternalEnergy
(
    const double rhoP,
    const double px,
    const double py,
    const double pz,
    const double energy
)
{
    return energy - 0.5*sqr3(px, py, pz)/clampMin(rhoP, OfVSmall);
}
