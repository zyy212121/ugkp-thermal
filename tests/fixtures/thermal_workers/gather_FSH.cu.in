  float want=((flags&2))?s->pCold2DFrozenArea[expected[dst]*1+j]:static_cast<float>(0);
  if (s->compactPCold2DFrozenArea[dst*1+j]!=want) {fprintf(stderr,"payload mismatch pCold2DFrozenArea dst=%d j=%d flags=%d pattern=%d block=%d n=%d\n",dst,j,flags,pattern,B,n);exit(3);}
 }
for(int dst=0;dst<(int)expected.size();++dst){if(s->compactPuxOld[dst]!=s->puxOld[expected[dst]]){fprintf(stderr,"payload old-velocity mismatch puxOld dst=%d\n",dst);exit(3);}}
for(int dst=0;dst<(int)expected.size();++dst){if(s->compactPuyOld[dst]!=s->puyOld[expected[dst]]){fprintf(stderr,"payload old-velocity mismatch puyOld dst=%d\n",dst);exit(3);}}
for(int dst=0;dst<(int)expected.size();++dst){if(s->compactPuzOld[dst]!=s->puzOld[expected[dst]]){fprintf(stderr,"payload old-velocity mismatch puzOld dst=%d\n",dst);exit(3);}}
 for(int dst=0;dst<(int)expected.size();++dst)if(s->published[dst]!=(s->pStuck[expected[dst]]!=0)){fprintf(stderr,"wall publication mismatch\n");exit(4);}
 cudaFree(s->px);cudaFree(s->compactPx);
cudaFree(s->puxOld);cudaFree(s->compactPuxOld);
cudaFree(s->puyOld);cudaFree(s->compactPuyOld);
cudaFree(s->puzOld);cudaFree(s->compactPuzOld);
cudaFree(s->py);cudaFree(s->compactPy);
cudaFree(s->pz);cudaFree(s->compactPz);
cudaFree(s->pux);cudaFree(s->compactPux);
cudaFree(s->puy);cudaFree(s->compactPuy);
cudaFree(s->puz);cudaFree(s->compactPuz);
cudaFree(s->pT);cudaFree(s->compactPT);
cudaFree(s->pTheta);cudaFree(s->compactPTheta);
cudaFree(s->pd);cudaFree(s->compactPd);
cudaFree(s->pm);cudaFree(s->compactPm);
cudaFree(s->pCellId);cudaFree(s->compactPCellId);
cudaFree(s->pStatus);cudaFree(s->compactPStatus);
cudaFree(s->pStuck);cudaFree(s->compactPStuck);
cudaFree(s->pStuckFaceId);cudaFree(s->compactPStuckFaceId);
cudaFree(s->pRng);cudaFree(s->compactPRng);
cudaFree(s->pOrigId);cudaFree(s->compactPOrigId);
cudaFree(s->pContactAge);cudaFree(s->compactPContactAge);
cudaFree(s->pDepositionArea);cudaFree(s->compactPDepositionArea);
cudaFree(s->pContactDuration);cudaFree(s->compactPContactDuration);
cudaFree(s->pContactMaximumArea);cudaFree(s->compactPContactMaximumArea);
cudaFree(s->pContactPeakFraction);cudaFree(s->compactPContactPeakFraction);
cudaFree(s->pColdNodeSpecificEnthalpy);cudaFree(s->compactPColdNodeSpecificEnthalpy);
cudaFree(s->pColdRingSolidMass);cudaFree(s->compactPColdRingSolidMass);
cudaFree(s->pColdFrozenArea);cudaFree(s->compactPColdFrozenArea);
cudaFree(s->pColdContactAge);cudaFree(s->compactPColdContactAge);
cudaFree(s->pCold2DNodeSpecificEnthalpy);cudaFree(s->compactPCold2DNodeSpecificEnthalpy);
cudaFree(s->pCold2DRingContactAge);cudaFree(s->compactPCold2DRingContactAge);
cudaFree(s->pCold2DFrozenArea);cudaFree(s->compactPCold2DFrozenArea);
 cudaFree(s->csrHeavyTaskCursor);cudaFree(s->cellParticleOffset);cudaFree(s->compactCellOffset);cudaFree(s->cellParticleCount);cudaFree(s->sortedParticleIndex);cudaFree(s->csrHeavyTaskCount);cudaFree(s->csrReductionTasks);cudaFree(s->published);cudaFree(s);
}
int main(){for(int n:{0,1,31,64,65,129,4097})for(int pattern:{0,1})for(int flags:{0,1,2,3})for(bool segmented:{false,true}) {run<32>(n,pattern,flags,segmented);run<64>(n,pattern,flags,segmented);run<128>(n,pattern,flags,segmented);run<256>(n,pattern,flags,segmented);}puts("all payload fields, order, filtered tails and wall publication passed");}
