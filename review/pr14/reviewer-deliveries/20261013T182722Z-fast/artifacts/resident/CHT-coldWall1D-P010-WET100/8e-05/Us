FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "8e-05";
    object      Us;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    impactWall
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    sideWalls
    {
        type            zeroGradient;
    }
}


