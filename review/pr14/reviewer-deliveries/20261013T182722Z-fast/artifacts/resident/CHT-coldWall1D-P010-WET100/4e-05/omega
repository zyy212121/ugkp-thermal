FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "4e-05";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 9.9999999999999995e-07;

boundaryField
{
    impactWall
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    sideWalls
    {
        type            zeroGradient;
    }
}


