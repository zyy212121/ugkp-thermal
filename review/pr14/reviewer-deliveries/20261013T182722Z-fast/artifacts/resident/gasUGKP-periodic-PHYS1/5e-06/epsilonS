FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "5e-06";
    object      epsilonS;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.0001;

boundaryField
{
    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    sides
    {
        type            empty;
    }
}


