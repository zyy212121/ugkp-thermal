#!/usr/bin/env bash

set -euo pipefail

case_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cleaner="${case_dir}/../../tools/clean_case_results.sh"

if [[ ${1:-} == --list ]]; then
    echo windSandShockTube
    exit 0
fi
if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != windSandShockTube ]]; }; then
    echo "Usage: $0 [windSandShockTube|--list]" >&2
    exit 2
fi

"${cleaner}" --check "${case_dir}"
"${cleaner}" "${case_dir}"
"${case_dir}/assets/build/clean_validation_solver.sh"
