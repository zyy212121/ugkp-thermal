#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
CLEANER="${ROOT}/../tools/clean_case_results.sh"
CASES=(sparse dense denseL2)
REQUESTED_CASES=("$@")

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "${CASES[@]}"
    exit 0
fi
clean_all=false
if (( ${#REQUESTED_CASES[@]} == 0 )); then
    REQUESTED_CASES=("${CASES[@]}")
    clean_all=true
fi
for requested in "${REQUESTED_CASES[@]}"; do
    [[ " ${CASES[*]} " == *" ${requested} "* ]] || {
        echo "Unknown two-phase validation case: ${requested}" >&2
        exit 2
    }
    "${CLEANER}" --check "${ROOT}/02_two_phase_validation/${requested}"
done
for requested in "${REQUESTED_CASES[@]}"; do
    "${CLEANER}" "${ROOT}/02_two_phase_validation/${requested}"
done
${clean_all} && rm -rf -- "${ROOT}/run_logs/Allrun02"
