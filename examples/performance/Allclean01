#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
CLEANER="${ROOT}/../tools/clean_case_results.sh"
CASES=(tadmor kurganov hlle hllc roe hllem hllc_adc slau2 slau2_2)
REQUESTED_CASES=("$@")

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "${CASES[@]}"
    exit 0
fi
clean_all=false
if (( ${#REQUESTED_CASES[@]} == 0 )); then
    REQUESTED_CASES=("${CASES[@]}")
    clean_all=true
fi
for requested in "${REQUESTED_CASES[@]}"; do
    [[ " ${CASES[*]} " == *" ${requested} "* ]] || {
        echo "Unknown single-phase case: ${requested}" >&2
        exit 2
    }
    "${CLEANER}" --check "${ROOT}/01_single_phase_nozzle/flux/${requested}"
done
for requested in "${REQUESTED_CASES[@]}"; do
    "${CLEANER}" "${ROOT}/01_single_phase_nozzle/flux/${requested}"
done
${clean_all} && rm -rf -- "${ROOT}/run_logs/Allrun01"
