FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "1.5/fluid";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.52223;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.52223;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.52223;
        value           uniform 1.52223;
    }
    symmetry
    {
        type            symmetry;
    }
    focusWall
    {
        type            kqRWallFunction;
        value           uniform 1.52223;
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 1.52223;
    }
    fluid_to_graphite
    {
        type            kqRWallFunction;
        value           uniform 1.52223;
    }
}


