FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    "(p|U|rho|T|Tglobal|phiLS|h|he).*"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-12;
        relTol 0;
    }
}

UGKP
{
    rhoMin 1e-12;
    TMin 1;
    robustFallback true;
    maxDiffusionNumber 0.25;
}

relaxationFactors {}
