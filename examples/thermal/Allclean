#!/usr/bin/env bash

set -euo pipefail

[[ $# -eq 1 ]] || { echo "Usage: ./Allclean <case-name>" >&2; exit 2; }

root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
case_name=$1

case "${case_name}" in
    MSS7_laminar|MSS7_turbulent_wallModel|MSS7_twoPhase_sparse|MSS7_twoPhase_dense) ;;
    *) echo "Unknown thermal case: ${case_name}" >&2; exit 2 ;;
esac

"${root}/mss7pre/clean_case.sh" "${case_name}"
rm -rf -- "${root}/results/${case_name}" "${root}/log/${case_name}"
if [[ -d "${root}/run_logs" ]]; then
    find "${root}/run_logs" -mindepth 2 -maxdepth 2 -type f -name "${case_name}.log" -delete
    find "${root}/run_logs" -mindepth 1 -type d -empty -delete
fi
