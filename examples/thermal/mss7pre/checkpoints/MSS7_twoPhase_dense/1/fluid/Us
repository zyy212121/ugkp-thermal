{
    version         2;
    format          ascii;
    class           volVectorField;
    location        "1/fluid";
    object          Us;
}
                                                                               

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ( 0 0 0 );
    }
    outlet
    {
        type            zeroGradient;
    }
    fluid_to_graphite
    {
        type            zeroGradient;
    }
    wedgeBack
    {
        type            wedge;
    }
    wedgeFront
    {
        type            wedge;
    }
    defaultFaces
    {
        type            empty;
    }
}


                                                                               
