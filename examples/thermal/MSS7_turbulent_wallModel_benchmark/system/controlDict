FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application chtMultiRegionFoam;
startFrom latestTime; startTime 1; stopAt endTime; endTime 4.5; deltaT 1e-7;
writeControl adjustableRunTime; writeInterval 0.01; purgeWrite 0;
writeFormat ascii; writePrecision 17; writeCompression off;
timeFormat general; timePrecision 10; runTimeModifiable yes;
adjustTimeStep yes; maxCo 0.8; maxDi 1; maxDeltaT 1e-5;
functions {
 wallHeatFlux { type wallHeatFlux; libs ("libfieldFunctionObjects.so"); region fluid; patches (fluid_to_graphite); executeControl writeTime; writeControl writeTime; log false; }
 solidHeatFlux { type wallHeatFlux; libs ("libfieldFunctionObjects.so"); region graphite; patches (graphite_to_fluid); executeControl writeTime; writeControl writeTime; log false; }
 yPlus { type yPlus; libs ("libfieldFunctionObjects.so"); region fluid; executeControl writeTime; writeControl writeTime; }

    mss7ThroatWallProbe
    {
        type                patchProbes;
        libs                ("libsampling.so");
        region              graphite;
        patchName           graphite_to_fluid;
        fields              (T);
        fixedLocations      true;
        probeLocations
        (
            (0.151410366795 0.011821249473 0)                                 
            (0.152401606784 0.011803651873 0)                                   
        );

        writeControl        runTime;
        writeInterval       0.01;
    }

    mss7ThroatTemperatureProbes
    {
        type                probes;
        libs                ("libsampling.so");
        region              graphite;
        fields              (T);
        fixedLocations      true;
        interpolationScheme cellPoint;

        probeLocations
        (
            (0.151945102963 0.021800000 0)                     
            (0.151945102963 0.041800000 0)                     
        );

        writeControl        runTime;
        writeInterval       0.01;
    }

}
