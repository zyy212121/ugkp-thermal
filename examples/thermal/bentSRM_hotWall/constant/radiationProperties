FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}

schemaVersion 1;

enabled true;
couplingInterval 0.1;

model
{
    mieTable "assets/radiation/alumina_mieTable.dat";

    do
    {
        nTheta 2;
        nPhi 4;
        maxSourceIterations 1000;
        sourceRelativeTolerance 1e-6;
        phaseBalanceTolerance 1e-8;
        maxPhaseBalanceIterations 100;
        radiationActiveEpsilonMin 1e-12;
        conservationRelativeTolerance 2e-5;
        maxPhaseScalingCorrection 100;
        IBoundaryCondition diffuseGrey;
        boundaryAbsorptivity 0.9;
        sourceRelaxation 0.7;
        linearSolverTolerance 1e-8;
        linearSolverRelTol 0;
        linearSolverMaxIterations 200;
        angleParallelThreads 4;

        boundaryRadiation
        {
            default
            {
                type diffuseGrey;
                emissivity 0.9;
            }
            inlet
            {
                type diffuseGrey;
                emissivity 0.95;
                T 2000;
            }
            outlet
            {
                type zeroIncoming;
                emissivity 1;
            }
        }
    }
}
