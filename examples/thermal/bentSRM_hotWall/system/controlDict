{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
                                                                               

application     CHT;

startFrom       startTime;

startTime       1.5;

stopAt          endTime;

endTime         3.0;

deltaT          1e-08;

writeControl    runTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     ascii;

writePrecision  17;

writeCompression off;

timeFormat      general;

timePrecision   17;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1e-05;

functions
{
    #include "bentSrmTemperatureProbesDict"
    #include "bentSrmWallHeatFluxesDict"
}


                                                                               
