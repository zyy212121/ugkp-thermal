#!/usr/bin/env bash
set -euo pipefail
app=$(cd "$(dirname "$0")" && pwd)
frontend=false
case ${1:-} in
  --host-checks) exec bash "$app/devtools/check_host.sh" ;;
  --frontend-only) frontend=true ;;
  '') ;;
  *) echo 'Usage: Allwmake [--host-checks|--frontend-only]' >&2; exit 2 ;;
esac
[[ ${WM_PROJECT_VERSION:-} == 10 ]] || { echo 'Source Foundation OpenFOAM 10 before building CHMT.' >&2; exit 2; }
build=${CHMT_BUILD:-$app/.build/native}
if $frontend; then build=${CHMT_FRONTEND_BUILD:-$app/.build/frontend};fi
mkdir -p "$build/generated"
flags=(-std=c++17 -DNoRepository -DWM_DP -DWM_LABEL_SIZE=32 -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -I"$build/generated"
 -I"$WM_PROJECT_DIR/src/OpenFOAM/lnInclude" -I"$WM_PROJECT_DIR/src/finiteVolume/lnInclude" -I"$WM_PROJECT_DIR/src/meshTools/lnInclude" -I"$WM_PROJECT_DIR/src/OSspecific/POSIX/lnInclude")
libs=(-L"$FOAM_LIBBIN" -lfiniteVolume -lmeshTools -lOpenFOAM -L"$FOAM_LIBBIN/$FOAM_MPI" -lPstream)
if $frontend; then
 python3 "$app/devtools/build_info.py" --compile-only --species-count "${UGKWP_GAS_SPECIES:-2}" --output "$build/generated"
 "${CXX:-g++}" "${flags[@]}" -DCHMT_FRONTEND_COMPILE_ONLY "$app/CHMT.C" "$app/mesh/Geometry.C" "${libs[@]}" -o "$build/CHMT-input-check"
 printf '%s\n' "FRONTEND_ONLY: $build/CHMT-input-check; no CUDA backend was built."
else
 nvcc=${NVCC:-nvcc}
 command -v "$nvcc" >/dev/null || { echo 'BLOCKED: native CHMT build requires the CUDA toolkit compiler nvcc.' >&2; exit 2; }
 [[ ${CHMT_CUDA_ARCH:-} =~ ^sm_[0-9]+$ ]] || { echo 'Set CHMT_CUDA_ARCH to the actual supported GPU architecture, e.g. sm_80.' >&2; exit 2; }
 cuda=${CUDA_HOME:-$(cd "$(dirname "$(command -v "$nvcc")")/.." && pwd)}
 python3 "$app/devtools/build_info.py" --species-count "${UGKWP_GAS_SPECIES:-2}" --arch "$CHMT_CUDA_ARCH" --nvcc "$nvcc" --output "$build/generated"
 "$nvcc" -std=c++17 -O2 -arch="$CHMT_CUDA_ARCH" -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -I"$app/../../common/gasNumerics" -c "$app/gpu/Backend.cu" -o "$build/Backend.o"
 "${CXX:-g++}" "${flags[@]}" "$app/CHMT.C" "$app/io/MultirateEvolution.C" "$app/materials/CpuMaterialDriver.C" "$app/materials/MaterialTransport.C" "$app/film/CpuFilmDriver.C" "$app/ablation/CpuSurfaceInterface.C" "$app/mesh/Geometry.C" "$app/restart/Checkpoint.C" "$build/Backend.o" "${libs[@]}" -L"$cuda/lib64" -Wl,-rpath,"$cuda/lib64" -lcudart -o "$build/CHMT"
 if [[ -n ${FOAM_USER_APPBIN:-} ]]; then mkdir -p "$FOAM_USER_APPBIN"; cp "$build/CHMT" "$FOAM_USER_APPBIN/CHMT"; fi
 printf '%s\n' "NATIVE_BUILD: $build/CHMT. Run the actual coupled acceptance cases before claiming GPU verification."
fi
