#!/usr/bin/env bash
set -euo pipefail
app=$(cd "$(dirname "$0")" && pwd)
cuda_arch=${CHMT_CUDA_ARCH:-${UGKWP_CUDA_ARCH:-sm_89}}
frontend=false
case ${1:-} in
  --host-checks) exec bash "$app/../../validation/tools/CHMT/devtools/check_host.sh" ;;
  --frontend-only) frontend=true ;;
  '') ;;
  *) echo 'Usage: Allwmake [--host-checks|--frontend-only]' >&2; exit 2 ;;
esac
build=${CHMT_BUILD:-$app/.build/native}
if $frontend; then build=${CHMT_FRONTEND_BUILD:-$app/.build/frontend};fi
mkdir -p "$build/generated"
flags=(-std=c++17 -O2 -fopenmp -DNoRepository -DWM_DP -DWM_LABEL_SIZE=32 -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -I"$build/generated"
 -I"$WM_PROJECT_DIR/src/OpenFOAM/lnInclude" -I"$WM_PROJECT_DIR/src/finiteVolume/lnInclude" -I"$WM_PROJECT_DIR/src/meshTools/lnInclude" -I"$WM_PROJECT_DIR/src/OSspecific/POSIX/lnInclude")
libs=(-L"$FOAM_LIBBIN" -lfiniteVolume -lmeshTools -lOpenFOAM -L"$FOAM_LIBBIN/$FOAM_MPI" -lPstream)
if $frontend; then
 python3 "$app/../../tool/CHMT/build_info.py" --compile-only --species-count "${UGKWP_GAS_SPECIES:-2}" --output "$build/generated"
 "${CXX:-g++}" "${flags[@]}" -DCHMT_FRONTEND_COMPILE_ONLY "$app/CHMT.C" "$app/mesh/Geometry.C" "${libs[@]}" -o "$build/CHMT-input-check"
 test -x "$build/CHMT-input-check"
 printf '%s\n' "FRONTEND_ONLY: $build/CHMT-input-check; no CUDA backend was built."
else
 source "$app/../../tool/cuda_build_flags.sh"
 nvcc=${NVCC:-${CUDA_HOME:-/usr/local/cuda}/bin/nvcc}
 command -v "$nvcc" >/dev/null || { echo 'BLOCKED: native CHMT build requires the CUDA toolkit compiler nvcc.' >&2; exit 2; }
 cuda=${CUDA_HOME:-$(cd "$(dirname "$(command -v "$nvcc")")/.." && pwd)}
 python3 "$app/../../tool/CHMT/build_info.py" --species-count "${UGKWP_GAS_SPECIES:-2}" --arch "$cuda_arch" --nvcc "$nvcc" --output "$build/generated"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 --expt-relaxed-constexpr -O2 -arch="$cuda_arch" -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -I"$app/../../common/gasNumerics" -c "$app/gpu/Backend.cu" -o "$build/Backend.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false --expt-relaxed-constexpr -arch="$cuda_arch" -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -I"$app/../../common/gasNumerics" -c "$app/gpu/MaterialBackend.cu" -o "$build/MaterialBackend.o"
 # Shared thermal particle owner is a separate translation unit, not a CHMT
 # implementation copy. Each local application build resolves its own objects.
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false --expt-relaxed-constexpr -arch="$cuda_arch" -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app/../../common" -I"$app/../../common/thermal" -c "$app/../../common/thermal/GpuResidentStrict.cu" -o "$build/ParticleResident.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false -arch="$cuda_arch" -I"$app/../../common" -c "$app/../../common/thermal/GpuWallEnergy64.cu" -o "$build/ParticleWallEnergy.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false -arch="$cuda_arch" -c "$app/../../common/gpu/SparseConjugateGradient.cu" -o "$build/SparseConjugateGradient.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false --expt-relaxed-constexpr -arch="$cuda_arch" -DUGKWP_GAS_SPECIES="${UGKWP_GAS_SPECIES:-2}" -I"$app" -I"$app/../../common" -c "$app/gpu/MaterialThermalBackend.cu" -o "$build/MaterialThermalBackend.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false -arch="$cuda_arch" -c "$app/../../common/gpu/ImplicitDiffusion.cu" -o "$build/ImplicitDiffusion.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false -arch="$cuda_arch" -c "$app/../../common/gpu/ThermalFieldOperators.cu" -o "$build/ThermalFieldOperators.o"
 ugkp_nvcc "$nvcc" "${ugkp_cuda_flags[@]}" -std=c++17 -O2 --fmad=false -arch="$cuda_arch" -c "$app/../../common/gpu/PolyhedralGeometry.cu" -o "$build/PolyhedralGeometry.o"
 "${CXX:-g++}" "${flags[@]}" -DCHMT_DEVICE_GEOMETRY "$app/CHMT.C" "$app/io/MultirateEvolution.C" "$app/materials/CpuMaterialDriver.C" "$app/materials/MaterialTransport.C" "$app/ablation/CpuSurfaceInterface.C" "$app/mesh/Geometry.C" "$app/restart/Checkpoint.C" "$build/Backend.o" "$build/MaterialBackend.o" "$build/ParticleResident.o" "$build/ParticleWallEnergy.o" "$build/SparseConjugateGradient.o" "$build/MaterialThermalBackend.o" "$build/ImplicitDiffusion.o" "$build/ThermalFieldOperators.o" "$build/PolyhedralGeometry.o" "${libs[@]}" -L"$cuda/lib64" -Wl,-rpath,"$cuda/lib64" -lcudart -o "$build/CHMT"
 test -x "$build/CHMT"
 if [[ -n ${FOAM_USER_APPBIN:-} ]]; then mkdir -p "$FOAM_USER_APPBIN"; cp "$build/CHMT" "$FOAM_USER_APPBIN/CHMT"; fi
 printf '%s\n' "NATIVE_BUILD: $build/CHMT. Run the actual coupled acceptance cases before claiming GPU verification."
fi
