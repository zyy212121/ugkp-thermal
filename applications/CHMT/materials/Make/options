CC = $(CHMT_CXX) -std=c++14 -m64

EXE_INC = \
    -std=c++14 \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/OpenFOAM/lnInclude \
    -I.. \
    -I$(CHMT_GENERATED) \
    -DCHMT_SPECIES_HEADER=\"CHMTSpecies.H\"

LIB_LIBS = \
    -L$(CHMT_LIBDIR) -lCHMTBackend \
    -Wl,-rpath,$(CHMT_LIBDIR) \
    -lfiniteVolume -lmeshTools -lOpenFOAM \
    -L$(FOAM_LIBBIN)/$(FOAM_MPI) -lPstream
