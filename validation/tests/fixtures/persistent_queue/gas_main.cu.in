
template<class T> void alloc(T*& p,int n){assert(cudaMallocManaged(&p,std::max(n,1)*sizeof(T))==cudaSuccess);}
int main(){
for(int cells:{1,5,31,32,33,73,257})for(int grid:{1,3,48})for(int block:{32,64,128,256}){
 DeviceState* s;alloc(s,1);s->deviceState=s;s->nCells=cells;s->particleCapacity=cells*301+1;
 s->csrHeavyReductionEnabled=1;s->csrHeavyWorkerGrid=grid;s->multiprocessorCount=grid;
 s->rhoMin=1e-12;s->csrReductionDirectoryKind=0;s->csrHeavyTaskCapacity=cells*8+1;
 alloc(s->csrHeavyTaskCount,1);alloc(s->csrHeavyCellCount,1);alloc(s->csrHeavyTaskCursor,1);
 alloc(s->csrCellTaskCount,cells+1);alloc(s->csrCellTaskOffset,cells+1);alloc(s->csrMultiTaskCellList,cells);
 alloc(s->cellParticleOffset,cells+1);s->preBaseCellOffset=s->cellParticleOffset;
 alloc(s->csrReductionTasks,s->csrHeavyTaskCapacity);alloc(s->csrHeavyPartials,8*s->csrHeavyTaskCapacity);
 alloc(s->V,cells);alloc(s->cellParticleCount,cells+1);alloc(s->poolThermalCount,cells);
 alloc(s->poissonPoolSampleTargetCount,cells);alloc(s->poissonCellCollisionProbability,cells);
 GpuReal** fields[]={&s->poissonPoolMass,&s->poissonPoolMomX,&s->poissonPoolMomY,&s->poissonPoolMomZ,&s->poissonPoolEnergy,&s->poissonPoolDiameter,&s->poissonPoolDiameter2,&s->momRhoP,&s->momRhoUPx,&s->momRhoUPy,&s->momRhoUPz,&s->momRhoEP,&s->momRhoPD,&s->momRhoHpP};
 for(auto p:fields)alloc(*p,cells);
 std::vector<int> counts(cells);s->cellParticleOffset[0]=0;
 for(int c=0;c<cells;++c){counts[c]=c%5==0?0:c%3==0?301:17;s->cellParticleOffset[c+1]=s->cellParticleOffset[c]+counts[c];s->csrCellTaskCount[c]=(counts[c]+63)/64;s->csrCellTaskOffset[c]=-991;s->V[c]=1;s->poissonCellCollisionProbability[c]=c%4==0?0:1;}
 s->reductionBlockThreads=64;s->lightBlocksPerSm=1024;
 assert(cub::DeviceScan::ExclusiveSum(nullptr,s->cellScanTempBytes,s->csrCellTaskCount,s->csrCellTaskOffset,cells+1)==cudaSuccess);
 assert(cudaMalloc(&s->cellScanTempStorage,s->cellScanTempBytes)==cudaSuccess);
 for(int repeat=0;repeat<2;++repeat){
  *s->csrHeavyTaskCount=-999;
  DeviceState producerHost=*s;
  countCsrReductionTasksKernel<<<(cells+1+block-1)/block,block>>>(s,0);
  assert(cub::DeviceScan::ExclusiveSum(producerHost.cellScanTempStorage,producerHost.cellScanTempBytes,producerHost.csrCellTaskCount,producerHost.csrCellTaskOffset,cells+1)==cudaSuccess);
  materializeCsrReductionTasksKernel<<<(cells+block-1)/block,block>>>(s,0);
  assert(cudaDeviceSynchronize()==cudaSuccess);
  int total=0;
  for(int c=0;c<cells;++c){
   assert(s->csrCellTaskCount[c]==(counts[c]+63)/64);total+=(counts[c]+63)/64;
   int end=s->cellParticleOffset[c];
   for(int t=s->csrCellTaskOffset[c];t<s->csrCellTaskOffset[c]+s->csrCellTaskCount[c];++t){auto d=s->csrReductionTasks[t];assert(d.cell==c && d.begin==end && d.end>d.begin && d.end-d.begin<=64);end=d.end;}
   assert(end==s->cellParticleOffset[c+1]);
  }
  assert(*s->csrHeavyTaskCount==total);
 }
 int tasks=0,multi=0;
 // Reverse reservation order catches erroneous use of offset[c+1].
 for(int c=cells-1;c>=0;--c)if(s->csrCellTaskCount[c]>0){s->csrCellTaskOffset[c]=tasks;if(s->csrCellTaskCount[c]>1)s->csrMultiTaskCellList[multi++]=c;for(int begin=s->cellParticleOffset[c];begin<s->cellParticleOffset[c+1];begin+=64)s->csrReductionTasks[tasks++]={c,begin,std::min(begin+64,s->cellParticleOffset[c+1]),0};}
 *s->csrHeavyTaskCount=tasks;*s->csrHeavyCellCount=multi;DeviceState host=*s;
 for(bool poisson:{true,false,true}){
  for(auto p:fields)assert(cudaMemset(*p,0,cells*sizeof(GpuReal))==cudaSuccess);
  cudaMemset(s->cellParticleCount,0,(cells+1)*sizeof(int));cudaMemset(s->poolThermalCount,0,cells*sizeof(int));cudaMemset(s->poissonPoolSampleTargetCount,0,cells*sizeof(int));
  *s->csrHeavyTaskCursor=123456;
  assert(launchCsrSegmentedPoolReduction(&host,0.01,poisson,block)==0);
  assert(cudaDeviceSynchronize()==cudaSuccess);
  // Empty cells must not add claims to a work queue containing real heavy tasks.
  *s->csrHeavyTaskCursor=0;
  accumulateCsrSegmentedMomentTasksPersistentKernel<<<grid,block,8*((block+31)/32)*sizeof(double)>>>(s);
  assert(cudaDeviceSynchronize()==cudaSuccess);
  if(*s->csrHeavyTaskCursor!=tasks+grid){fprintf(stderr,"empty-cell queue claims: got %d expected %d\n",*s->csrHeavyTaskCursor,tasks+grid);return 1;}
  *s->csrHeavyTaskCursor=654321;
  assert(launchCsrSegmentedMomentReduction(&host,block)==0);
  assert(cudaDeviceSynchronize()==cudaSuccess);
  for(int c=0;c<cells;++c){
   for(int k=0;k<14;++k){double want=0;bool rejected=k<7&&poisson&&c%4==0;if(!rejected)for(int i=s->cellParticleOffset[c];i<s->cellParticleOffset[c+1];++i)want+=(i%7+1)*(k%7+1);if((*fields[k])[c]!=want){fprintf(stderr,"cell=%d component=%d got=%g expected=%g\n",c,k,double((*fields[k])[c]),want);return 1;}}
   assert(s->cellParticleCount[c]==counts[c]);assert(s->poolThermalCount[c]==(poisson&&c%4==0?0:counts[c]));
   assert(s->poissonPoolSampleTargetCount[c]==s->poolThermalCount[c]);
  }
 }
 for(auto p:fields)cudaFree(*p);
 cudaFree(s->cellScanTempStorage);
 cudaFree(s->csrHeavyTaskCount);cudaFree(s->csrHeavyCellCount);cudaFree(s->csrHeavyTaskCursor);cudaFree(s->csrCellTaskCount);cudaFree(s->csrCellTaskOffset);cudaFree(s->csrMultiTaskCellList);cudaFree(s->cellParticleOffset);cudaFree(s->csrReductionTasks);cudaFree(s->csrHeavyPartials);cudaFree(s->V);cudaFree(s->cellParticleCount);cudaFree(s->poolThermalCount);cudaFree(s->poissonPoolSampleTargetCount);cudaFree(s->poissonCellCollisionProbability);cudaFree(s);
}
puts("gas persistent queue: independent sums, empty slots, reversed heavy offsets, zero-probability tasks and reused cursors passed");
}
