struct Dim{int x;};Dim threadIdx{0},blockIdx{0},blockDim{1},gridDim{1};
constexpr double OfVSmall=2.2250738585072014e-308;
double clampMin(double x,double lo){return std::max(x,lo);}
template<class T>T clampRange(T x,T lo,T hi){return std::min(std::max(x,lo),hi);}
double finiteOr(double x,double alt){return std::isfinite(x)?x:alt;}
double sqr3(double x,double y,double z){return x*x+y*y+z*z;}
struct PressureProjectionCell
{
    double ux0, uy0, uz0, ux1, uy1, uz1, theta1, thermalScale, thetaScale;
    bool active, resolved;
};

struct DeviceState{
 int compactPStatus[32]={},compactPCellId[32]={};
 double compactPux[32]={},compactPuy[32]={},compactPuz[32]={},compactPTheta[32]={};
 int csrCellLocalPathEnabled=0; int nCells=3,nFaces=6,particleCapacity=9;
 int* particleCountDevice;double rhoSolid=1000,epsSMin=1e-9,thetaMin=1e-8;
 PressureProjectionCell pressureProjectionCache[3]={};
double Usx[32]={};
