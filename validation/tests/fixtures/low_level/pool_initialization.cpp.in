
// Execute the actual kernels as scalar CPU calls. This checks publication order,
// bounds and exact field values; it does not emulate CUDA scheduling.
#include <algorithm>
#include <cassert>
#include <cmath>
#include <cstring>
#include <limits>
#include <cstdio>
using Real=@REAL@;
#define __global__
#define __device__
#define __forceinline__ inline
#define GPU_OPERATOR_REAL Real
#define GPU_OPERATOR_TIME double
#define GPU_OPERATOR_R(x) Real(x)
#define GPU_POOL_INITIALIZATION_WITH_PROBABILITY @GAS@
#define UGKP_DEVELOPMENT_PROBES
struct Dim { int x=0; } blockIdx,threadIdx,blockDim;
template<class T> T clampMin(T x,T y){return std::max(x,y);}
template<class T> T finiteOr(T x,T y){return std::isfinite(x)?x:y;}
int clampRange(int x,int a,int b){return std::max(a,std::min(x,b));}
struct DeviceState {
 int nCells=4,particleCapacity=7,particleCount=11,diagnostic=-91;
 int csrHeavyReductionEnabled=1;
 int* particleCountDevice=&particleCount;
 int* diagnosticPreTransportParticleCount=&diagnostic;
 int csrCellTaskCount[4]={0,1,2,3};
 int poolThermalCount[4],poissonPoolSampleTargetCount[4];
 Real poolThermalSumUx[4],poolThermalSumUy[4],poolThermalSumUz[4],poolThermalSumU2[4];
 Real poissonPoolMass[4],poissonPoolMomX[4],poissonPoolMomY[4],poissonPoolMomZ[4];
 Real poissonPoolEnergy[4],poissonPoolDiameter[4],poissonPoolDiameter2[4];
 Real poissonCellCollisionProbability[4];
 int publications[4]={0,0,0,0};
 DeviceState(){for(int i=0;i<4;++i){
  poolThermalCount[i]=i+2;poissonPoolSampleTargetCount[i]=i+3;
  for(Real* p:{poolThermalSumUx,poolThermalSumUy,poolThermalSumUz,poolThermalSumU2,
      poissonPoolMass,poissonPoolMomX,poissonPoolMomY,poissonPoolMomZ,poissonPoolEnergy,
      poissonPoolDiameter,poissonPoolDiameter2,poissonCellCollisionProbability})p[i]=Real(10+i);
 }}
};
Real poissonCollisionProbabilityForCell(DeviceState& s,int c,double dt){
 // Publication must precede pool clearing. The real probability algebra is
 // unchanged and is covered by actual-consumer CUDA regressions separately.
 assert(s.poolThermalCount[c]==c+2 && s.poissonPoolMass[c]==Real(10+c));
 ++s.publications[c];return Real(dt+s.poissonPoolMass[c]);
}
#define clearPoissonThermalPoolKernel oldClear
#include "reference/@LABEL@-clear.cuh"
#undef clearPoissonThermalPoolKernel
#define clearPoissonThermalPoolKernel newClear
#include "operators/clearPoissonThermalPoolKernel.cuh"
#undef clearPoissonThermalPoolKernel
#include "GpuCollisionPoolTarget.cuh"
#define preparePoissonPoolSamplingKernel oldPrepare
#include "reference/prepare-sampling.cuh"
#undef preparePoissonPoolSamplingKernel
#define preparePoissonPoolSamplingKernel newPrepare
#include "operators/preparePoissonPoolSamplingKernel.cuh"
#undef preparePoissonPoolSamplingKernel
void equal(const DeviceState& a,const DeviceState& b){
 assert(a.diagnostic==b.diagnostic);
 assert(std::memcmp(a.publications,b.publications,sizeof a.publications)==0);
 assert(std::memcmp(a.poolThermalCount,b.poolThermalCount,sizeof a.poolThermalCount)==0);
 assert(std::memcmp(a.poissonPoolSampleTargetCount,b.poissonPoolSampleTargetCount,sizeof a.poissonPoolSampleTargetCount)==0);
 const Real* aa[]={a.poolThermalSumUx,a.poolThermalSumUy,a.poolThermalSumUz,a.poolThermalSumU2,a.poissonPoolMass,
 a.poissonPoolMomX,a.poissonPoolMomY,a.poissonPoolMomZ,a.poissonPoolEnergy,a.poissonPoolDiameter,a.poissonPoolDiameter2,a.poissonCellCollisionProbability};
 const Real* bb[]={b.poolThermalSumUx,b.poolThermalSumUy,b.poolThermalSumUz,b.poolThermalSumU2,b.poissonPoolMass,
 b.poissonPoolMomX,b.poissonPoolMomY,b.poissonPoolMomZ,b.poissonPoolEnergy,b.poissonPoolDiameter,b.poissonPoolDiameter2,b.poissonCellCollisionProbability};
 for(int j=0;j<12;++j)assert(std::memcmp(aa[j],bb[j],4*sizeof(Real))==0);
}
int main(){
 for(int cells:{0,1,4})for(int heavy:{0,1})for(int count:{-1,3,11})for(int diag:{0,1}){
  DeviceState a,b; a.nCells=b.nCells=cells;a.csrHeavyReductionEnabled=b.csrHeavyReductionEnabled=heavy;
  a.particleCount=b.particleCount=count;
  if(!diag)a.diagnosticPreTransportParticleCount=b.diagnosticPreTransportParticleCount=nullptr;
  blockDim.x=32;blockIdx.x=0;
  for(int c=0;c<32;++c){threadIdx.x=c;
#if GPU_POOL_INITIALIZATION_WITH_PROBABILITY
   oldClear(&a,0.125);newClear(&b,0.125);
#else
   oldClear(&a);newClear(&b);
#endif
  }
  equal(a,b);
#if GPU_POOL_INITIALIZATION_WITH_PROBABILITY
  assert(b.diagnostic==(diag?clampRange(count,0,7):-91));
#else
  assert(b.diagnostic==-91);
#endif
  for(int c=0;c<4;++c){
   assert(b.poolThermalCount[c]==(c<cells?0:c+2));
   assert(b.publications[c]==(@GAS@ && heavy && c<cells && c>=2?1:0));
  }
 }
 for(int cells:{0,1,4})for(Real mass:{Real(-1),Real(0),Real(2),std::numeric_limits<Real>::quiet_NaN()})for(int representatives:{-1,0,3}){
  DeviceState a,b;a.nCells=b.nCells=cells;
  for(int c=0;c<4;++c){a.poissonPoolMass[c]=b.poissonPoolMass[c]=mass;a.poolThermalCount[c]=b.poolThermalCount[c]=representatives;}
  for(int c=0;c<32;++c){threadIdx.x=c;oldPrepare(&a);newPrepare(&b);}
  equal(a,b);
  for(int c=0;c<cells;++c)assert(b.poissonPoolSampleTargetCount[c]==(mass>0 && representatives>0?representatives:0));
 }
 puts("PASS pool initialization: old/new exact values, bounds, cache and diagnostic order");
}
