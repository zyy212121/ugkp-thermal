FoamFile { version 2.0; format ascii; class dictionary; object scheme; }
precision 64;

gasTimeStep
{
    maxCo 0.3;
    maxDeltaT 0.00001;
    courantUpdateInterval 1;
    maximumTimeStepGrowth 1;
    adjustTimeStep true;
}
gasNumerics
{
    fluxScheme Kurganov;
    gasLimiter barthJespersen;
    ddtSchemes
    {
        default SSPRK2;
    }
    gradSchemes
    {
        default Gauss linear;
    }
    divSchemes
    {
        default none;
        div(phi,U) Gauss MUSCL;
        div(phi,e) Gauss MUSCL;
        div(phi,K) Gauss MUSCL;
        div(phi,(p|rho)) Gauss MUSCL;
        div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    }
    laplacianSchemes
    {
        default Gauss linear corrected;
    }
    interpolationSchemes
    {
        default linear;
    }
    snGradSchemes
    {
        default corrected;
    }
}
particle
{
    tracking
    {
        maxFaceWalkHops 8;
    }
}

wallLayer
{
    maxIterations 60;
    relativeTolerance 1e-8;
    absoluteTolerance 1e-10;
    nodes 8;
    stretch 2;
}
