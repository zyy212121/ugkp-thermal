+    q=subprocess.run([sys.executable,str(ROOT/'tests/fixtures/gas_auto/gas_auto_pool.py'),str(ROOT),str(out)],capture_output=True,text=True,timeout=600)
+    assert q.returncode==0,q.stdout+q.stderr
