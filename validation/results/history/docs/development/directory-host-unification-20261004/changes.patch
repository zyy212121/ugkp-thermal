+// Test-only linker tracing observes the real CUDA task-builder launches.
+// No production counters or handwritten copy of its directory selector.
+int taskCountsLaunched=0,taskWritesLaunched=0;
+extern "C" cudaError_t __real_cudaLaunchKernel(const void*,dim3,dim3,void**,size_t,cudaStream_t);
+#if CUDART_VERSION >= 13000
+extern "C" cudaError_t __real___cudaLaunchKernel(cudaKernel_t,dim3,dim3,void**,size_t,cudaStream_t);
+extern "C" cudaError_t __wrap___cudaLaunchKernel(cudaKernel_t f,dim3 g,dim3 b,void**args,size_t bytes,cudaStream_t stream){
+    cudaKernel_t counts{},writes{};
+    check(cudaGetKernel(&counts,countCsrReductionTasksKernel));
+    check(cudaGetKernel(&writes,materializeCsrReductionTasksKernel));
+    if(f==counts)++taskCountsLaunched;
+    if(f==writes)++taskWritesLaunched;
+    return __real___cudaLaunchKernel(f,g,b,args,bytes,stream);
+}
+#endif
+extern "C" cudaError_t __wrap_cudaLaunchKernel(const void*f,dim3 g,dim3 b,void**args,size_t bytes,cudaStream_t stream){
+    if(f==reinterpret_cast<const void*>(countCsrReductionTasksKernel))++taskCountsLaunched;
+    if(f==reinterpret_cast<const void*>(materializeCsrReductionTasksKernel))++taskWritesLaunched;
+    return __real_cudaLaunchKernel(f,g,b,args,bytes,stream);
+}
+#undef UGKP_DEV_PROBE_ENTER
+#undef UGKP_DEV_PROBE_LEAVE
+#undef UGKP_DEV_PROBE_LEAVE_IF
+#define UGKP_DEV_PROBE_ENTER(name) ((void)0)
+#define UGKP_DEV_PROBE_LEAVE(name) ((void)0)
+#define UGKP_DEV_PROBE_LEAVE_IF(name,flag) ((void)0)
+int productionPreStage(DeviceState*s,int block){
+PRODUCTION_PRE_STAGE
+    return 0;
+}
+int productionCompactionStage(DeviceState*s,int block){
+    cudaError_t err=cudaSuccess;
+    const int particleGrid=s->particleWorkGrid;
+    const bool exactSurvivorDirectory=true;
+    const bool fusedSurvivorGather=exactSurvivorDirectory&&postTransportFusePayload;
+PRODUCTION_COMPACTION_STAGE
+    return 0;
+}
+constexpr bool gasHasBaseOnly=GPU_DIRECTORY_HAS_BASE_ONLY!=0;
+void seedParticle(DeviceState*s,int i,int c){
+    s->pCellId[i]=c;s->pStatus[i]=1;s->pRng[i]=123456789ULL+i*333ULL;
+    s->pm[i]=1+(i%3)*.25;s->pux[i]=(i%17-8)*.125;s->puy[i]=(i%7-3)*.25;s->puz[i]=(i%5-2)*.25;
+    s->pTheta[i]=.75;s->pd[i]=.001;s->pT[i]=1000;
+}
+int main(int argc,char**argv){
+    setvbuf(stdout,nullptr,_IONBF,0);
+    require(argc==4,"path, scenario and block arguments required");
+    const int path=atoi(argv[1]),scenario=atoi(argv[2]),block=atoi(argv[3]);
+    const bool initiallyL2=scenario<2,inspect=scenario==1||scenario==2;
+    const int high[4]={block+1,block,block,block-1};
+    const int base[4]={block/2,block/2,block/2,block/2};
+    const int* initial=path==2?base:high;
+    DeviceState*s=make(block),*r=make(block);
+    populate(s,TestDirectory::full,initial);
+    s->csrHeavyReductionMode=2;s->csrHeavyAutoInterval=3;s->csrHeavyReductionEnabled=initiallyL2;
+    s->csrWarpAggregatedBinning=1;
+#if GPU_DIRECTORY_HAS_BASE_ONLY
+    s->csrSplitPreDirectoryEnabled=1;
+#endif
